  cv.addEventListener('pointermove', e => {
    if (ptrs.has(e.pointerId)) ptrs.set(e.pointerId, [e.clientX, e.clientY]);
    if (pinch && ptrs.size === 2) { const [p1, p2] = [...ptrs.values()], d = Math.hypot(p1[0] - p2[0], p1[1] - p2[1]); const [cx, cy] = toCv((p1[0] + p2[0]) / 2, (p1[1] + p2[1]) / 2); zoomAt(pinch.km * pinch.d / d / MV.km, cx, cy); moved = 99; return; }
    if (drag) { const r = cv.getBoundingClientRect(), sc = mapState.W / r.width, dx = (e.clientX - drag.x) * sc, dy = (e.clientY - drag.y) * sc; moved = Math.max(moved, Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y));
      if (moved > 4) { MV.lon = drag.lon - dx / mapState.pxPerKm / (mapState.k * 111.32); MV.lat = drag.lat + dy / mapState.pxPerKm / 111.32; hideTip(box); map(); } return; }
    const p = nearest(e.clientX, e.clientY); cv.style.cursor = p ? 'pointer' : 'grab';
    if (p) { const r = BY[p.id], br = box.getBoundingClientRect(); showTip(box, `<b>${esc(r.name)}</b><br>${dDE(r.date)} · ${de(r.km, 1)} km`, e.clientX - br.left, e.clientY - br.top); } else hideTip(box);
  });
  const up = e => { ptrs.delete(e.pointerId);
    if (drag && moved <= 4 && e.type === 'pointerup') { const p = nearest(e.clientX, e.clientY); if (p) { hideTip(box); showAct(p.id); } }
    if (ptrs.size < 2) pinch = null; if (!ptrs.size) drag = null; };
  cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);
  cv.addEventListener('pointerleave', () => { if (!ptrs.size) hideTip(box); });
  cv.addEventListener('wheel', e => { e.preventDefault(); const [cx, cy] = toCv(e.clientX, e.clientY); zoomAt(Math.exp(e.deltaY * .0015), cx, cy); }, {passive: false});
  const slider = document.getElementById('zoom');
  slider.addEventListener('input', () => { const f = 1 - slider.value / 1000; const km = ZMIN * Math.pow(ZMAX / ZMIN, f); MV.km = km; map(); });
  document.getElementById('zoomIn').onclick = () => zoomAt(1 / 1.6, mapState.W / 2, mapState.H / 2);
  document.getElementById('zoomOut').onclick = () => zoomAt(1.6, mapState.W / 2, mapState.H / 2);
  document.querySelectorAll('#mapPresets button').forEach(b => b.onclick = () => { const [la, lo, km] = b.dataset.v.split(',').map(Number); setView(la, lo, km); });
})();


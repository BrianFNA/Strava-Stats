document.getElementById('foot').innerHTML = `<span>Quelle: ${ALL.length} Strava-Exporte (GPX/FIT) plus die Hamburgtour aus der SkateGlow-Aufzeichnung. Alle „Fehler“-Aktivitäten sind entfernt.</span>
  <span>Bereinigung: Punkte mit unplausiblen Sprüngen raus (Laufen über 26, Skateboard über 50, Rad über 60, Gehen über 10 km/h), Sprünge nach Pausen nur gezählt, wenn sie zu Fuß oder rollend möglich sind.${broken.length ? ` Nicht in den Summen: ${broken.map(r => `„${esc(r.name)}“ (${dDE(r.date)}, GPS-Spur unbrauchbar)`).join(', ')}.` : ''}</span>
  <span>Bewegungszeit = Abschnitte über 4 km/h (Gehen über 1,5 km/h). „Im Dunkeln“ = Sonne tiefer als 6° unter dem Horizont. Werte können leicht von der Strava-App abweichen.</span>`;

document.getElementById('mapLegend').innerHTML = CATS.map(c => `<span style="display:inline-flex;gap:7px;align-items:center"><span class="sw" style="background:var(${CV[c]})"></span>${c}</span>`).join('');
function drawAll() { lamps(); monthly(); progress(); patterns(); map(); }
stars(); cards(); facts(); drawAll();
let rz, lw = innerWidth; addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(() => { stars(); if (innerWidth !== lw) { lw = innerWidth; lamps(); monthly(); progress(); patterns(); map(); } }, 150); });
})();

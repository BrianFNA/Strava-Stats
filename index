<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: fixed night sky (stars + drifting fog) behind one 1120px column; hero = total + a row of street lamps (one per year, glow = km);
   every chart mark opens a side sheet: list of activities -> activity detail. Deliberately single dark theme. */
:root {
  color-scheme: dark;
  --sky-0: #050812;
  --sky-1: #0b1222;
  --panel: #0f1628;
  --panel-2: #141d33;
  --line: rgba(176, 196, 240, .12);
  --line-2: rgba(176, 196, 240, .22);
  --ink: #e9edf6;
  --ink-2: #aab4c8;
  --muted: #6f7b93;
  --lamp: #f4c47e;
  --lamp-glow: rgba(244, 180, 96, .55);
  --fog: rgba(150, 168, 205, .10);
  --c-skate: #c9822a;
  --c-run: #4a86de;
  --c-hike: #2a9e72;
  --c-bike: #c062b6;
  --display: "Big Shoulders Display", "Arial Narrow", system-ui, sans-serif;
  --body: "Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { background: var(--sky-0); }
body { background: var(--sky-0); color: var(--ink); font: 400 16px/1.55 var(--body); min-height: 100%; }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--lamp); outline-offset: 2px; }

/* sky */
.sky { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(120% 80% at 70% -10%, #13203d 0%, var(--sky-1) 40%, var(--sky-0) 100%); }
.sky canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.fog { position: absolute; left: -30%; right: -30%; height: 55vh; bottom: -12vh; pointer-events: none; filter: blur(30px); opacity: .9; }
.fog.a { background: radial-gradient(40% 50% at 30% 60%, var(--fog), transparent 70%), radial-gradient(35% 45% at 75% 55%, rgba(150,168,205,.08), transparent 70%); animation: drift 70s linear infinite alternate; }
.fog.b { bottom: -20vh; background: radial-gradient(45% 50% at 55% 55%, rgba(160,175,210,.09), transparent 70%), radial-gradient(30% 40% at 10% 50%, rgba(150,168,205,.07), transparent 70%); animation: drift 95s linear infinite alternate-reverse; }
@keyframes drift { from { transform: translateX(-8%); } to { transform: translateX(8%); } }
@media (prefers-reduced-motion: reduce) { .fog { animation: none; } }

.wrap { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; padding-inline: 20px; padding-block: 40px 80px; display: grid; gap: 72px; }
h1, h2, h3 { margin: 0; font-family: var(--display); font-weight: 800; letter-spacing: .005em; line-height: .95; text-wrap: balance; }
h2 { font-size: clamp(2rem, 4.6vw, 2.8rem); }
h3 { font-size: 1.35rem; font-weight: 600; letter-spacing: .01em; }
p { margin: 0; }
.eyebrow { font: 500 .74rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
.lede { color: var(--ink-2); max-width: 62ch; }
.num { font-variant-numeric: tabular-nums; }
section { display: grid; gap: 20px; min-width: 0; }
.head { display: grid; gap: 10px; }

/* hero */
.hero { display: grid; gap: 28px; padding-top: 24px; }
.hero h1 { font-size: clamp(4.2rem, 15vw, 9.5rem); font-weight: 800; color: var(--ink); text-shadow: 0 0 40px rgba(244, 196, 126, .18); }
.hero h1 small { font-size: .32em; color: var(--lamp); margin-left: .12em; letter-spacing: .02em; }
.hero .who { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: baseline; }
.hero .who b { font: 600 1.15rem var(--body); }
.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.stats div { padding: 16px 0 14px; display: grid; gap: 2px; min-width: 0; }
.stats div + div { padding-left: 18px; border-left: 1px solid var(--line); }
.stats b { font: 800 clamp(1.9rem, 4vw, 2.6rem)/1 var(--display); }
.stats span { color: var(--ink-2); font-size: .88rem; }

/* lamps */
.lamps { position: relative; }
.lamps svg { display: block; width: 100%; height: auto; overflow: visible; }
.lamps .lamp { cursor: pointer; }
.lamps .lamp:hover .glow, .lamps .lamp:focus-visible .glow { opacity: 1; }
.lamps text { font-family: var(--mono); font-size: 12px; fill: var(--ink-2); }
.lamps text.y { font-family: var(--display); font-weight: 800; font-size: 22px; fill: var(--ink); }
.cap { color: var(--muted); font-size: .85rem; }

/* share */
.share { display: grid; gap: 10px; }
.share-bar { display: flex; gap: 3px; height: 10px; }
.share-bar button { border: 0; padding: 0; height: 100%; cursor: pointer; border-radius: 2px; }
.share-bar button:hover { filter: brightness(1.2); }
.legend { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: .88rem; color: var(--ink-2); }
.legend button { background: none; border: 0; padding: 2px 0; cursor: pointer; color: var(--ink-2); display: inline-flex; align-items: center; gap: 7px; }
.legend button:hover { color: var(--ink); }
.sw { width: 9px; height: 9px; border-radius: 2px; display: inline-block; flex: none; }

/* panels */
.panel { background: color-mix(in srgb, var(--panel) 88%, transparent); border: 1px solid var(--line); border-radius: 6px; padding: 20px; min-width: 0; }
.panel .sub { color: var(--muted); font-size: .85rem; margin: 4px 0 14px; }
.chart { position: relative; width: 100%; }
.chart svg { display: block; width: 100%; height: auto; overflow: visible; }
.chart text { fill: var(--muted); font: 400 11px var(--mono); }
.hit { cursor: pointer; }
.tip { position: absolute; pointer-events: none; z-index: 5; background: #e9edf6; color: #0b1222; padding: 7px 10px; border-radius: 4px; font-size: .8rem; line-height: 1.35; white-space: nowrap; transform: translate(-50%, calc(-100% - 10px)); box-shadow: 0 6px 24px rgba(0,0,0,.4); }
.tip small { color: #4b5671; }
.two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }

/* category blocks */
.cats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.cat { display: grid; gap: 16px; align-content: start; }
.cat-top { display: flex; justify-content: space-between; align-items: end; gap: 12px; flex-wrap: wrap; }
.cat-top h3 { font-size: 1.9rem; font-weight: 800; display: flex; gap: 10px; align-items: center; }
.cat-top .km { font: 800 2.4rem/1 var(--display); }
.cat-top .km small { font-size: .45em; color: var(--muted); margin-left: 3px; }
.kv { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px 14px; }
.kv div { display: grid; gap: 1px; min-width: 0; }
.kv b { font: 600 1.1rem/1.2 var(--body); font-variant-numeric: tabular-nums; }
.kv span { font-size: .76rem; color: var(--muted); overflow-wrap: anywhere; }
.rows { display: grid; }
.rows button { display: grid; grid-template-columns: 7.2em 5.6em 6.4em minmax(0, 1fr); gap: 10px; align-items: baseline; text-align: left; background: none; border: 0; border-top: 1px solid var(--line); padding: 8px 4px; cursor: pointer; font-size: .88rem; color: var(--ink); border-radius: 0; }
.rows button:hover { background: rgba(244, 196, 126, .06); }
.rows .l { color: var(--ink-2); }
.rows .n { font-variant-numeric: tabular-nums; }
.rows .w { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.more { justify-self: start; background: none; border: 1px solid var(--line-2); color: var(--ink); border-radius: 999px; padding: 7px 14px; font-size: .85rem; cursor: pointer; }
.legend button.more { border: 1px solid var(--line-2); padding: 7px 14px; color: var(--ink); }
.more:hover { border-color: var(--lamp); color: var(--lamp); }

/* facts */
.facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); }
.fact { background: none; border: 0; border-bottom: 1px solid var(--line); text-align: left; padding: 20px 20px 20px 0; display: grid; gap: 8px; align-content: start; color: var(--ink); min-width: 0; }
.fact:nth-child(3n+2), .fact:nth-child(3n) { padding-left: 20px; border-left: 1px solid var(--line); }
button.fact { cursor: pointer; }
button.fact:hover b { color: var(--lamp); }
.fact b { font: 800 2.2rem/1 var(--display); transition: color .2s; }
.fact p { color: var(--ink-2); font-size: .92rem; }
.fact .go { font: 500 .72rem var(--mono); color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }

/* map */
#map { width: 100%; display: block; cursor: grab; touch-action: none; border-radius: 4px; }
.zoombar { display: flex; align-items: center; gap: 12px; margin-top: 14px; }
.zoombar input[type=range] { flex: 1; min-width: 0; accent-color: var(--lamp); height: 28px; }
.zoombar .icon-btn { font-size: 1.2rem; line-height: 1; }
.zoombar .zv { min-width: 9.5em; text-align: right; color: var(--ink-2); font: 500 .8rem var(--mono); }
.presets { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.presets .more { padding: 6px 12px; font-size: .82rem; }
.map-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin-top: 12px; }

footer { color: var(--muted); font-size: .82rem; display: grid; gap: 6px; max-width: 80ch; }

/* sheet */
.scrim { position: fixed; inset: 0; z-index: 20; background: rgba(3, 5, 12, .55); backdrop-filter: blur(2px); }
.sheet { position: fixed; z-index: 21; top: 0; right: 0; bottom: 0; width: min(480px, 100%); background: var(--panel); border-left: 1px solid var(--line-2); display: grid; grid-template-rows: auto 1fr; box-shadow: -20px 0 60px rgba(0, 0, 0, .5); padding-top: env(safe-area-inset-top, 0px); }
.sheet-head { display: flex; align-items: center; gap: 8px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
.sheet-head .t { flex: 1; min-width: 0; font: 500 .74rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.icon-btn { background: none; border: 1px solid var(--line-2); width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: grid; place-items: center; color: var(--ink); flex: none; }
.icon-btn:hover { border-color: var(--lamp); color: var(--lamp); }
.sheet-body { overflow-y: auto; padding: 18px 18px calc(28px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 18px; align-content: start; }
.sheet h3.big { font-size: 2.2rem; font-weight: 800; line-height: 1; }
.meta { color: var(--ink-2); font-size: .9rem; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; }
.chip { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; border: 1px solid var(--line-2); border-radius: 999px; padding: 2px 10px; color: var(--ink-2); }
.chip.night { border-color: rgba(244, 196, 126, .4); color: var(--lamp); }
.list { display: grid; }
.list button { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--line); padding: 11px 4px; cursor: pointer; }
.list button:hover { background: rgba(244, 196, 126, .06); }
.list .nm { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.list .dt { grid-column: 2; font-size: .8rem; color: var(--muted); }
.list .km { grid-row: 1 / span 2; grid-column: 3; text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
.list .km small { display: block; font-weight: 400; color: var(--muted); font-size: .78rem; }
.list .sw { grid-row: 1 / span 2; }
.sum { display: flex; gap: 18px; flex-wrap: wrap; color: var(--ink-2); font-size: .9rem; }
.sum b { color: var(--ink); font-weight: 600; }
.dgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 12px; }
.dgrid div { display: grid; gap: 1px; min-width: 0; }
.dgrid b { font: 800 1.55rem/1.05 var(--display); }
.dgrid span { color: var(--muted); font-size: .76rem; }
#mini { width: 100%; height: auto; display: block; border-radius: 4px; background: var(--sky-0); }
.note { font-size: .82rem; color: var(--ink-2); border-left: 2px solid var(--lamp); padding-left: 10px; }
.be { display: grid; }
.be div { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); padding: 7px 0; font-size: .88rem; font-variant-numeric: tabular-nums; }
.be div span:first-child { color: var(--ink-2); }

@media (max-width: 860px) {
  .cats, .two { grid-template-columns: minmax(0, 1fr); }
  .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .fact:nth-child(3n+2), .fact:nth-child(3n) { padding-left: 0; border-left: 0; }
  .fact:nth-child(2n) { padding-left: 20px; border-left: 1px solid var(--line); }
}
@media (max-width: 560px) {
  .wrap { padding-inline: 16px; gap: 56px; }
  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stats div:nth-child(3) { padding-left: 0; border-left: 0; }
  .stats div:nth-child(n+3) { border-top: 1px solid var(--line); }
  .kv { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .facts { grid-template-columns: minmax(0, 1fr); }
  .fact:nth-child(n) { padding-left: 0; border-left: 0; }
  .rows button { grid-template-columns: 6.4em 5em minmax(0, 1fr); }
  .rows button .p { display: none; }
  .sheet { top: auto; height: 90vh; width: 100%; border-left: 0; border-top: 1px solid var(--line-2); border-radius: 14px 14px 0 0; }
  .dgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .zoombar .zv { min-width: 0; font-size: .72rem; }
}
</style>


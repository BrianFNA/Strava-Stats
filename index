document.querySelectorAll('#shareBar button, #shareLegend button').forEach(b => b.onclick = () => showList(b.dataset.c, ALL.filter(r => r.cat === b.dataset.c)));

function lamps() {
  const box = document.getElementById('lamps'); box.innerHTML = '';
  const years = [...new Set(ALL.map(r => r.date.slice(0, 4)))].sort();
  const yk = years.map(y => sum(OK.filter(r => r.date.startsWith(y)), r => r.km)), mx = Math.max(...yk);
  const W = Math.max(box.clientWidth, 300), H = 230, base = 168;
  const svg = el('svg', {viewBox: `0 0 ${W} ${H}`, role: 'group', 'aria-label': 'Kilometer pro Jahr'}, box);
  const defs = el('defs', {}, svg);
  const g = el('radialGradient', {id: 'glow'}, defs);
  el('stop', {offset: '0', 'stop-color': '#ffd79a', 'stop-opacity': '.95'}, g); el('stop', {offset: '.25', 'stop-color': '#f4b460', 'stop-opacity': '.45'}, g); el('stop', {offset: '1', 'stop-color': '#f4b460', 'stop-opacity': '0'}, g);
  const cone = el('linearGradient', {id: 'cone', x1: 0, y1: 0, x2: 0, y2: 1}, defs);
  el('stop', {offset: '0', 'stop-color': '#f4b460', 'stop-opacity': '.22'}, cone); el('stop', {offset: '1', 'stop-color': '#f4b460', 'stop-opacity': '0'}, cone);
  el('line', {x1: 0, x2: W, y1: base, y2: base, stroke: css('--line-2')}, svg);
  const gap = W / years.length;
  years.forEach((y, i) => {
    const cx = gap * (i + .5), f = yk[i] / mx, top = 46, r = 18 + 70 * Math.sqrt(f);
    const gr = el('g', {class: 'lamp'}, svg);
    el('path', {d: `M${cx - 6},${top + 6} L${cx - 30 - 30 * f},${base} L${cx + 30 + 30 * f},${base} L${cx + 6},${top + 6}Z`, fill: 'url(#cone)', opacity: .4 + .6 * f}, gr);
    el('circle', {class: 'glow', cx, cy: top, r, fill: 'url(#glow)', opacity: .35 + .65 * f, style: 'transition:opacity .2s'}, gr);
    el('line', {x1: cx, x2: cx, y1: top + 4, y2: base, stroke: 'rgba(200,210,235,.35)', 'stroke-width': 2}, gr);
    el('path', {d: `M${cx - 9},${top + 4} h18 l-4,-7 h-10z`, fill: 'rgba(200,210,235,.55)'}, gr);
    el('circle', {cx, cy: top + 6, r: 3.2, fill: '#fff3dc'}, gr);
    el('text', {x: cx, y: base + 30, 'text-anchor': 'middle', class: 'y'}, gr).textContent = y;
    el('text', {x: cx, y: base + 50, 'text-anchor': 'middle'}, gr).textContent = `${de(yk[i])} km`;
    el('rect', {x: cx - gap / 2, y: 0, width: gap, height: H, fill: 'transparent'}, gr);
    gr.setAttribute('tabindex', '0'); gr.setAttribute('role', 'button'); gr.setAttribute('aria-label', `${y}: ${de(yk[i])} km`);
    const go = () => showList(`Jahr ${y}`, ALL.filter(r => r.date.startsWith(y)));
    gr.addEventListener('click', go); gr.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
  });
}

// ---------- monthly ----------
function monthly() {
  const box = document.getElementById('monthly'); box.innerHTML = '';
  const months = []; for (let d = new Date(first.slice(0, 7) + '-01T12:00'); d.toISOString().slice(0, 7) <= last.slice(0, 7); d.setMonth(d.getMonth() + 1)) months.push(d.toISOString().slice(0, 7));
  const M = Object.fromEntries(months.map(m => [m, Object.fromEntries(CATS.map(c => [c, 0]))]));
  OK.forEach(r => { M[r.date.slice(0, 7)][r.cat] += r.km; });
  const W = Math.max(box.clientWidth, 300), H = W < 600 ? 240 : 300, L = 40, R = 6, T = 10, B = 26;
  const max = Math.max(...months.map(m => sum(CATS, c => M[m][c]))), stp = max > 300 ? 100 : 50, ymax = Math.ceil(max / stp) * stp;
  const svg = el('svg', {viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': 'Kilometer pro Monat'}, box);
  const y = v => T + (H - T - B) * (1 - v / ymax);
  for (let v = 0; v <= ymax; v += stp) { el('line', {x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: css(v ? '--line' : '--line-2')}, svg); el('text', {x: L - 6, y: y(v) + 4, 'text-anchor': 'end'}, svg).textContent = v; }
  const bw = (W - L - R) / months.length;
  months.forEach((m, i) => {
    const x = L + i * bw, w = Math.max(bw - (bw > 8 ? 3 : 1.5), 1.5); let acc = 0;
    const st = CATS.filter(c => M[m][c] > 0);
    st.forEach((c, j) => {
      const v = M[m][c], y1 = y(acc + v), h = Math.max(y(acc) - y1 - (j ? 2 : 0), 1), top = j === st.length - 1, rx = top ? Math.min(2.5, w / 2) : 0;
      el('path', {d: `M${x},${y1 + h} V${y1 + rx} Q${x},${y1} ${x + rx},${y1} H${x + w - rx} Q${x + w},${y1} ${x + w},${y1 + rx} V${y1 + h} Z`, fill: col(c)}, svg);
      acc += v;
    });
    const [yy, mm] = m.split('-');
    if (mm === '01') el('text', {x: x, y: H - 6}, svg).textContent = yy;
    const tot = sum(CATS, c => M[m][c]);
    const hit = el('rect', {x, y: T, width: bw, height: H - T - B, fill: 'transparent'}, svg);
    const acts = ALL.filter(r => r.date.startsWith(m));
    if (!acts.length) return;
    bindHit(hit, box, svg, W, H, x + bw / 2, y(tot), () => `<b>${MON[+mm - 1]} ${yy}</b> · ${de(tot, 1)} km${st.map(c => `<br><span class="sw" style="background:${col(c)}"></span> ${c}: ${de(M[m][c], 1)} km`).join('')}<br><small>Antippen für ${acts.length} Aktivität${acts.length > 1 ? 'en' : ''}</small>`,
      () => showList(`${MONL[+mm - 1]} ${yy}`, acts), `${MONL[+mm - 1]} ${yy}: ${de(tot)} km`);
  });
  document.getElementById('monthlyLegend').innerHTML = CATS.map(c => `<span style="display:inline-flex;gap:7px;align-items:center"><span class="sw" style="background:var(${CV[c]})"></span>${c}</span>`).join('');
}

// ---------- category blocks ----------
function cards() {
  const BE = {
    'Skateboard': [[1000, '1 km'], [10000, '10 km'], [21097, 'Halbmarathon'], [42195, 'Marathon'], [50000, '50 km'], [100000, '100 km'], [200000, '200 km']],
    'Laufen': [[400, '400 m'], [1000, '1 km'], [5000, '5 km'], [10000, '10 km'], [21097, 'Halbmarathon'], [42195, 'Marathon']],
    'Wandern & Gehen': [[1000, '1 km'], [10000, '10 km']], 'Radfahren': [[1000, '1 km'], [10000, '10 km']],
  };
  document.getElementById('cats').innerHTML = CATS.map(c => {
    const A = OK.filter(r => r.cat === c), km = sum(A, r => r.km), mov = sum(A, r => r.moving_s);
    const longest = A.reduce((a, r) => r.km > a.km ? r : a), top = A.reduce((a, r) => r.vmax_kmh > a.vmax_kmh ? r : a);
    const isRun = c === 'Laufen' || c === 'Wandern & Gehen';
    const rows = BE[c].map(([d, lab]) => {
      const k = 'be_' + d, b = A.filter(r => r[k]).sort((p, q) => p[k] - q[k])[0];

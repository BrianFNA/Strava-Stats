function tip(box) { let t = box.querySelector('.tip'); if (!t) { t = document.createElement('div'); t.className = 'tip'; t.hidden = true; box.appendChild(t); } return t; }
function showTip(box, html, x, y) { const t = tip(box); t.innerHTML = html; t.hidden = false; t.style.left = Math.min(Math.max(x, 80), box.clientWidth - 80) + 'px'; t.style.top = y + 'px'; }
function hideTip(box) { tip(box).hidden = true; }
function bindHit(node, box, svg, W, H, x, y, html, onClick, label) {
  node.classList.add('hit'); node.setAttribute('tabindex', '0'); node.setAttribute('role', 'button'); if (label) node.setAttribute('aria-label', label);
  const show = () => { const r = svg.getBoundingClientRect(); showTip(box, html(), x / W * r.width, y / H * r.height); };
  node.addEventListener('mouseenter', show); node.addEventListener('focus', show);
  node.addEventListener('mouseleave', () => hideTip(box)); node.addEventListener('blur', () => hideTip(box));
  node.addEventListener('click', () => { hideTip(box); onClick(); });
  node.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); hideTip(box); onClick(); } });
}

// ---------- sheet ----------
const sheet = document.getElementById('sheet'), scrim = document.getElementById('scrim'), body = document.getElementById('sheetBody');
const backBtn = document.getElementById('sheetBack'); let stack = [], lastFocus = null;
function openView(v, push = true) {
  if (sheet.hidden) { lastFocus = document.activeElement; stack = []; }
  if (push) stack.push(v);
  sheet.hidden = false; scrim.hidden = false; document.body.style.overflow = 'hidden';
  backBtn.hidden = stack.length < 2;
  body.scrollTop = 0;
  if (v.type === 'list') renderList(v); else renderDetail(BY[v.id]);
  document.getElementById('sheetClose').focus({preventScroll: true});
}
function closeSheet() { sheet.hidden = true; scrim.hidden = true; document.body.style.overflow = ''; stack = []; lastFocus?.focus?.({preventScroll: true}); }
backBtn.onclick = () => { stack.pop(); openView(stack[stack.length - 1], false); };
document.getElementById('sheetClose').onclick = closeSheet; scrim.onclick = closeSheet;
addEventListener('keydown', e => { if (e.key === 'Escape' && !sheet.hidden) closeSheet(); });
const showList = (title, acts, sub) => openView({type: 'list', title, ids: acts.map(r => r.id), sub});
const showAct = id => openView({type: 'detail', id});

function renderList(v) {
  const acts = v.ids.map(i => BY[i]).sort((a, b) => b.start.localeCompare(a.start));
  document.getElementById('sheetTitle').textContent = `${acts.length} Aktivitäten`;
  const ok = acts.filter(r => !r.broken);
  body.innerHTML = `<h3 class="big">${esc(v.title)}</h3>
    ${v.sub ? `<p class="meta">${esc(v.sub)}</p>` : ''}
    <div class="sum"><span><b class="num">${de(sum(ok, r => r.km), 1)}</b> km</span><span><b class="num">${hm(sum(ok, r => r.moving_s))}</b> in Bewegung</span><span><b class="num">${acts.length}</b> Aktivitäten</span></div>
    <div class="list">${acts.map(r => `<button data-id="${r.id}"><span class="sw" style="background:var(${CV[r.cat]})"></span><span class="nm">${esc(r.name)}</span><span class="dt">${dDE(r.date)} · ${tOf(r.start)} Uhr · ${r.cat}</span><span class="km">${de(r.km, 1)} km<small>${hm(r.moving_s)}</small></span></button>`).join('')}</div>`;
  body.querySelectorAll('.list button').forEach(b => b.onclick = () => showAct(b.dataset.id));
}

function renderDetail(r) {
  document.getElementById('sheetTitle').textContent = `${r.cat} · ${dDE(r.date)}`;
  const stopPct = r.elapsed_s ? (1 - r.moving_s / r.elapsed_s) * 100 : 0;
  const nightPct = r.km ? r.night_km / r.km * 100 : 0;
  const isRun = r.cat === 'Laufen' || r.cat === 'Wandern & Gehen';
  const BEL = {400: '400 m', 1000: '1 km', 5000: '5 km', 10000: '10 km', 21097: 'Halbmarathon', 42195: 'Marathon', 50000: '50 km', 100000: '100 km', 200000: '200 km'};
  const bes = Object.keys(r).filter(k => k.startsWith('be_') && r[k]).map(k => [+k.slice(3), r[k]]).sort((a, b) => a[0] - b[0]);

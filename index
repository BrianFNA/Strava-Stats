  if (r.broken) notes.push(`GPS-Spur unbrauchbar (${de(r.raw_km, 1)} km laut GPS). Nicht in den Summen.`);
  else if (r.raw_km - r.km > 0.3) notes.push(`${de(r.raw_km - r.km, 1)} km GPS-Sprünge rausgerechnet (roh ${de(r.raw_km, 1)} km).`);
  body.innerHTML = `
    <div style="display:grid;gap:10px"><h3 class="big">${esc(r.name)}</h3>
    <div class="meta"><span class="chip"><span class="sw" style="background:var(${CV[r.cat]})"></span>${r.cat}</span>${nightPct > 50 ? '<span class="chip night">überwiegend nachts</span>' : ''}<span>${WDL[r.weekday]}, ${dDE(r.date)} · ${tOf(r.start)} bis ${endT} Uhr</span></div></div>
    <canvas id="mini" width="880" height="560" aria-label="Streckenverlauf"></canvas>
    <div class="dgrid">
      <div><b class="num">${de(r.km, r.km < 100 ? 2 : 1)}</b><span>Kilometer</span></div>
      <div><b class="num">${hms(r.moving_s)}</b><span>in Bewegung</span></div>
      <div><b class="num">${hms(r.elapsed_s)}</b><span>gesamt</span></div>
      <div><b class="num">${r.moving_s ? speedTxt(r, r.moving_s, r.km) : '–'}</b><span>${isRun ? 'Ø Pace' : 'Ø Tempo'} in Bewegung</span></div>
      <div><b class="num">${r.vmax_kmh ? de(r.vmax_kmh, 1) + ' km/h' : '–'}</b><span>Spitze (30 s Ø)</span></div>
      <div><b class="num">${de(r.gain_m)} m</b><span>Höhenmeter</span></div>
      <div><b class="num">${de(stopPct)} %</b><span>Pausenanteil</span></div>
      <div><b class="num">${de(r.night_km, 1)} km</b><span>im Dunkeln</span></div>
      <div><b class="num">${r.ele_max != null ? de(r.ele_max) + ' m' : '–'}</b><span>höchster Punkt</span></div>
    </div>
    ${notes.map(n => `<p class="note">${n}</p>`).join('')}
    <div><h3>${isRun ? 'Tempo' : 'Geschwindigkeit'} und Höhe</h3><p class="sub" style="color:var(--muted);font-size:.82rem;margin:4px 0 8px">Je 250 m. Linie: ${isRun ? 'km/h' : 'km/h'}, Fläche: Höhe.</p><div class="chart" id="profile"></div></div>
    ${bes.length ? `<div><h3>Bestzeiten in dieser Aktivität</h3><div class="be" style="margin-top:8px">${bes.map(([d, s]) => `<div><span>${BEL[d] || d + ' m'}</span><span>${hms(s)} · ${speedTxt(r, s, d / 1000)}</span></div>`).join('')}</div></div>` : ''}
    <button class="more" id="sameDay">Alle Aktivitäten im ${MONL[+r.date.slice(5, 7) - 1]} ${r.date.slice(0, 4)}</button>`;
  drawMini(r); drawProfile(r);
  document.getElementById('sameDay').onclick = () => { const m = r.date.slice(0, 7); showList(`${MONL[+m.slice(5) - 1]} ${m.slice(0, 4)}`, ALL.filter(x => x.date.startsWith(m))); };
}

function drawMini(r) {
  const cv = document.getElementById('mini'), ctx = cv.getContext('2d'), W = cv.width, H = cv.height, pad = 36;
  const tr = r.track; if (!tr || tr.length < 2) return;
  let a0 = 90, a1 = -90, o0 = 180, o1 = -180; tr.forEach(([a, b]) => { a0 = Math.min(a0, a); a1 = Math.max(a1, a); o0 = Math.min(o0, b); o1 = Math.max(o1, b); });
  const k = Math.cos((a0 + a1) / 2 * Math.PI / 180), sx = (o1 - o0) * k || 1e-4, sy = (a1 - a0) || 1e-4;
  const s = Math.min((W - 2 * pad) / sx, (H - 2 * pad) / sy), ox = (W - sx * s) / 2, oy = (H - sy * s) / 2;
  const P = ([a, b]) => [ox + (b - o0) * k * s, H - oy - (a - a0) * s];
  ctx.fillStyle = css('--sky-0'); ctx.fillRect(0, 0, W, H);
  const c = col(r.cat);
  ctx.lineJoin = 'round'; ctx.lineCap = 'round';
  [[10, .08], [5, .18], [2.2, 1]].forEach(([w, a]) => { ctx.globalAlpha = a; ctx.strokeStyle = c; ctx.lineWidth = w; ctx.beginPath(); tr.forEach((p, i) => { const [x, y] = P(p); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }); ctx.stroke(); });
  ctx.globalAlpha = 1;
  const [sx0, sy0] = P(tr[0]), [ex, ey] = P(tr[tr.length - 1]);
  ctx.fillStyle = css('--ink'); ctx.beginPath(); ctx.arc(sx0, sy0, 6, 0, 7); ctx.fill();
  ctx.strokeStyle = css('--ink'); ctx.lineWidth = 2.5; ctx.beginPath(); ctx.arc(ex, ey, 8, 0, 7); ctx.stroke();
  const km = (o1 - o0) * 111.32 * k; const step = km > 60 ? 20 : km > 20 ? 5 : km > 6 ? 2 : km > 2 ? 1 : .5;
  const px = step / 111.32 * s; ctx.strokeStyle = css('--ink-2'); ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(pad, H - 20); ctx.lineTo(pad + px, H - 20); ctx.stroke();
  ctx.fillStyle = css('--ink-2'); ctx.font = '500 20px "IBM Plex Mono", monospace'; ctx.fillText(`${de(step, step < 1 ? 1 : 0)} km`, pad, H - 30);
  ctx.textAlign = 'right'; ctx.fillText('● Start  ○ Ziel', W - pad + 20, H - 20);
}

function drawProfile(r) {
  const box = document.getElementById('profile'); if (!box) return; box.innerHTML = '';
  const P = r.prof || []; if (P.length < 2) { box.innerHTML = '<p class="cap">Zu kurz für ein Profil.</p>'; return; }
  const W = Math.max(box.clientWidth, 280), H = 170, L = 40, R = 40, T = 10, B = 24;
  const kmMax = P[P.length - 1][0];
  const vs = P.map(p => p[1]).filter(v => v != null), es = P.map(p => p[2]).filter(v => v != null);
  const vMax = Math.max(5, Math.ceil((Math.max(...vs, 0)) / 5) * 5);
  const eMin = Math.floor(Math.min(...es) / 10) * 10, eMax = Math.max(eMin + 20, Math.ceil(Math.max(...es) / 10) * 10);
  const x = k => L + (W - L - R) * k / kmMax, yv = v => T + (H - T - B) * (1 - v / vMax), ye = e => T + (H - T - B) * (1 - (e - eMin) / (eMax - eMin));
  const svg = el('svg', {viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': 'Geschwindigkeit und Höhe über die Strecke'}, box);
  [0, .5, 1].forEach(f => { const v = vMax * f; el('line', {x1: L, x2: W - R, y1: yv(v), y2: yv(v), stroke: css('--line')}, svg); el('text', {x: L - 6, y: yv(v) + 4, 'text-anchor': 'end'}, svg).textContent = de(v); el('text', {x: W - R + 6, y: ye(eMin + (eMax - eMin) * f) + 4}, svg).textContent = de(eMin + (eMax - eMin) * f) + ' m'; });
  if (es.length > 1) {
    let d = `M${x(0)},${H - B}`; P.forEach(p => { if (p[2] != null) d += `L${x(p[0])},${ye(p[2])}`; }); d += `L${x(kmMax)},${H - B}Z`;
    el('path', {d, fill: 'rgba(170,180,200,.10)', stroke: 'rgba(170,180,200,.35)', 'stroke-width': 1}, svg);
  }
  if (vs.length > 1) {
    let d = '', pen = false; P.forEach(p => { if (p[1] == null) { pen = false; return; } d += `${pen ? 'L' : 'M'}${x(p[0])},${yv(p[1])}`; pen = true; });
    el('path', {d, fill: 'none', stroke: col(r.cat), 'stroke-width': 2, 'stroke-linejoin': 'round'}, svg);
  }
  const step = kmMax > 100 ? 50 : kmMax > 40 ? 10 : kmMax > 15 ? 5 : kmMax > 4 ? 1 : .5;
  for (let k = 0; k <= kmMax + 1e-9; k += step) el('text', {x: x(k), y: H - 6, 'text-anchor': 'middle'}, svg).textContent = de(k, step < 1 ? 1 : 0);
  const cross = el('line', {y1: T, y2: H - B, stroke: css('--ink-2'), 'stroke-width': 1, opacity: 0}, svg);
  const hitR = el('rect', {x: L, y: T, width: W - L - R, height: H - T - B, fill: 'transparent'}, svg);
  hitR.addEventListener('mousemove', e => {
    const rr = svg.getBoundingClientRect(); const k = (e.clientX - rr.left) / rr.width * W; const km = (k - L) / (W - L - R) * kmMax;
    const p = P.reduce((a, q) => Math.abs(q[0] - km) < Math.abs(a[0] - km) ? q : a);
    cross.setAttribute('x1', x(p[0])); cross.setAttribute('x2', x(p[0])); cross.setAttribute('opacity', .6);
    showTip(box, `<b>km ${de(p[0], 1)}</b><br>${p[1] != null ? de(p[1], 1) + ' km/h' : '–'} · ${p[2] != null ? de(p[2]) + ' m' : ''}`, x(p[0]) / W * rr.width, T / H * rr.height + 20);
  });
  hitR.addEventListener('mouseleave', () => { cross.setAttribute('opacity', 0); hideTip(box); });
}

